{
	"name": "laneh",
	"private": true,
	"version": "4.2.1",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "TZ=Europe/Berlin vitest run",
		"test:watch": "TZ=Europe/Berlin vitest",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"full-start": "concurrently --kill-others \"npm run dev\" \"npm run db:start\"",
		"migrate:prod": "vite-node scripts/migrate.ts",
		"start": "node build",
		"serve": "npm run migrate:prod && npm run start"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.3.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^9.39.1",
		"@inlang/paraglide-js": "^2.4.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.54.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/cookie-signature": "^1.1.2",
		"@types/fast-levenshtein": "^0.0.4",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"concurrently": "^10.0.5",
		"drizzle-kit": "^0.31.9",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.53.11",
		"svelte-check": "^4.4.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@capacitor/android": "^8.3.1",
		"@capacitor/app": "^8.1.0",
		"@capacitor/background-runner": "^3.0.0",
		"@capacitor/core": "^8.3.1",
		"@capacitor/filesystem": "^8.1.3",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/share": "^8.0.2",
		"@capacitor/status-bar": "^8.0.1",
		"@electric-sql/pglite": "^0.5.7",
		"@hono/zod-validator": "^0.9.1",
		"@lucide/svelte": "^1.50.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"cookie-signature": "^1.2.2",
		"drizzle-orm": "^0.45.1",
		"fast-levenshtein": "^3.0.0",
		"hash-wasm": "^4.12.0",
		"hono": "^4.12.11",
		"pg": "^8.23.0",
		"zod": "^4.3.6"
	}
}
